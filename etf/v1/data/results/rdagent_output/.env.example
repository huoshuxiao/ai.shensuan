# 本文件是 rdagent_output/.env 的受版本控制模板（.env 本身被 .gitignore 忽略，因为它随时可能被补上 OPENAI_API_KEY）。
# 部署新机器：cp .env.example .env 后按本机绝对路径改 APP_TPL 即可。
# 下面保留原作者的演进注释，说明每个开关治的是哪个病。

# RD-Agent(Q) 本地模型配置（ollama），被 rdagent_driver.py 自动装载
# 换云端模型时改成对应 provider 前缀并补 OPENAI_API_KEY 即可
# 模型演进：qwen2.5:7b → qwen2.5-coder:7b（修弃用误用）→ deepseek-r1:8b
#   → 短暂试 minicpm-v4.5:8b（视觉-语言系，与 RD-Agent pandas 代码
#   生成口径不合，已回退）→ R1 复跑：配置层已适配，但 ollama 服务被
#   systemd 里的 CUDA_VISIBLE_DEVICES=-1 OLLAMA_NUM_GPUS=0 锁死在纯 CPU
#   （965M 仅 2GB 显存也装不下 8B），单次平凡调用 7.5min、hypothesis
#   调用 2.4h 未归，整轮不可行 → 回 7B 系。
# 09-22 按「回收可用因子定义」目标横向对比后选 qwen2.5:7b：12:54 轮回收 5 个
#   且名字带作用列（可翻译），coder:7b 两轮分别 0 个 / 1 个且假设跑偏成元因子。
#   生成口径由 scenarios/qlib/prompts.yaml 的覆盖收紧（禁因子值做输入 + 强制
#   <N>-day <SMA|STD|MAX|MIN|VWAP> of <Price|Volume> 命名）。
LITELLM_CHAT_MODEL=ollama_chat/qwen2.5:7b
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
LITELLM_MAX_RETRY=3
LITELLM_RETRY_WAIT_SECONDS=3

# —— 本地 ollama 通用兼容开关（非 R1 专属，对 coder 同样适用）——
# RD-Agent 默认强制 response_format={'type':'json_object'}，ollama 侧模型
# 不支持该严格模式 → 反复 auto-continue 重试（上轮 coder 因此刷了 26 次
# "does not support response" 告警）。关掉后改走「提示词内要求 JSON +
# JSONParser 从正文抽取」的兼容路径（见 base.py:632）；R1 轮已实测该通路
# 能正常吐出合法 JSON，故保留为本地模型的稳态配置。
LITELLM_ENABLE_RESPONSE_SCHEMA=false
# 剥离思考标签的开关：coder 不产此类标签，关掉以免正则空转。换回带思考
# 输出的模型时再按需打开（注意 RD-Agent 的正则只认 <think>/ 成对标签，
# 对 R1 的思考标签其实无效，R1 靠的是 LiteLLM 把 reasoning 放独立字段）。
LITELLM_REASONING_THINK_RM=false

# —— 演化轮数上限（rdagent 默认 10，前缀 CoSTEER_）——
# 本轮目标是跑到 running 拿 IC，不是把某个因子演化到完美：09-22 那轮
# 10/10 演化全败也照样没进 running，纯属空烧 LLM 时间。配合提示词把每代
# 因子数从 12 压到 2，2 任务 × 4 次演化的最坏调用量才塞得进一晚上。
CoSTEER_MAX_LOOP=4

# —— 模板覆盖根目录（点号 URI 的唯一可行通道）——
# tpl.load_content 里两种 URI 规则不同：
#   非点号（如 scenarios.qlib.prompts:xxx）候选含「进程 CWD 相对路径」→ rdagent_output/
#     下放文件即可覆盖，09-22 的因子假设收紧就是靠它（日志计数 >0 已证）。
#   点号（如 factor_coder/eva_utils.py:487 的 .prompts:evaluator_final_decision_v1_system、
#     factor_experiment.py:35 的 .prompts:qlib_factor_interface）候选只有 caller_dir
#     （即 site-packages 内）与 PROJ_PATH/app_tpl 两处，**根本不看 CWD**——上一轮把覆盖文件
#     放进 rdagent_output/ 根下，计数为 0 就是这个原因。
# 所以那两个键必须放进 app_tpl 镜像树。注意 RDAgentSettings 没有 env_prefix（不像
# LiteLLMSettings 有 LITELLM_），字段名即变量名，写 RD_AGENT_SETTINGS_APP_TPL 会被静默忽略。
# pathlib 的 "/" 遇绝对路径会吞掉左操作数，故给绝对路径即可把覆盖目录指到包外，
# 不动 site-packages 一个字节。已验证：两个点号键命中、同文件兄弟键仍回落包内。
APP_TPL=<本仓库绝对路径>/etf/v1/data/results/rdagent_output/_tpl  # 实例见 .env，必须绝对路径
